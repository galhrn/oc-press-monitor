# ---------------------------------------------------------------------------
# OurCrowd Press Monitor - environment
# Every variable is optional; the defaults below are what the code uses.
# Copy to .env only if you need to override something.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

# --- storage (AD-04) -------------------------------------------------------
DB_PATH=./data/press.sqlite

# --- local LLM (AD-17, AD-18) ----------------------------------------------
# Ollama must be running locally. No cloud LLM is used anywhere in this project.
OLLAMA_HOST=http://127.0.0.1:11434
# Confirmed by the model bake-off - see README "Model selection".
OLLAMA_MODEL=llama3.2:3b
# Optional arbiter for low-confidence items. Left unset: the cascade is off (AD-07).
# OLLAMA_ARBITER_MODEL=qwen2.5:7b-instruct
OLLAMA_CONCURRENCY=3
# Right-sized to our ~150-token inputs instead of the 4096-8192 default.
OLLAMA_NUM_CTX=1024
OLLAMA_NUM_PREDICT=96
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT_MS=60000

# --- collection ------------------------------------------------------------
# Ordered list. Use `fixture` to run fully offline.
NEWS_PROVIDERS=gdelt,googlenews
# "Last quarter" = a rolling window (assumption A1).
QUARTER_WINDOW_DAYS=90
# Caps loud companies (SpaceX, Anthropic...) so they cannot eat the budget (A4, AD-22).
MAX_ITEMS_PER_COMPANY=25

# --- alerting (AD-13) ------------------------------------------------------
ALERT_CHANNELS=console,file
ALERT_FILE_PATH=./data/alerts.log.json
ALERT_LOOKBACK_HOURS=48

# --- scheduling (AD-12) ----------------------------------------------------
CRON_SCHEDULE=0 8 * * *
CRON_TIMEZONE=Asia/Jerusalem

# --- api -------------------------------------------------------------------
API_PORT=3000
