{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@oc/core": ["packages/core/src/index.ts"],
      "@oc/core/*": ["packages/core/src/*.ts"],
      "@oc/ollama": ["packages/ollama/src/index.ts"],
      "@oc/registry": ["packages/registry/src/index.ts"],
      "@oc/collector": ["packages/collector/src/index.ts"],
      "@oc/classifier": ["packages/classifier/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts", "scripts/**/*.ts", "test/**/*.ts", "*.config.ts"]
}
