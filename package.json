{
  "name": "oc-press-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Press mentions monitoring, sentiment classification and dashboard for OurCrowd portfolio companies.",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:check": "node scripts/check-docs.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run docs:check",
    "db:migrate": "tsx scripts/migrate.ts",
    "enrich": "tsx scripts/enrich-companies.ts",
    "bench": "tsx scripts/bench-ollama.ts",
    "collect": "tsx scripts/collect.ts",
    "measure:prefilter": "tsx scripts/measure-prefilter.ts",
    "skeleton": "tsx scripts/skeleton.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "fast-xml-parser": "^5.10.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.23.8"
  }
}
