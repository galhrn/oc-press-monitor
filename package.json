{
  "name": "oc-press-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Press mentions monitoring, sentiment classification and dashboard for OurCrowd portfolio companies.",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:check": "node scripts/check-docs.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run docs:check",
    "db:migrate": "tsx scripts/migrate.ts",
    "enrich": "tsx scripts/enrich-companies.ts",
    "bench": "tsx scripts/bench-ollama.ts",
    "collect": "tsx scripts/collect.ts",
    "backfill": "tsx scripts/run-backfill.ts",
    "serve": "tsx scripts/serve.ts",
    "web:dev": "vite --config apps/web/vite.config.ts",
    "web:build": "vite build --config apps/web/vite.config.ts",
    "measure:prefilter": "tsx scripts/measure-prefilter.ts",
    "audit:coverage": "tsx scripts/coverage-audit.ts",
    "gold:build": "tsx scripts/build-gold-set.ts",
    "eval": "tsx scripts/eval-classifier.ts",
    "skeleton": "tsx scripts/skeleton.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.10.1",
    "lucide-react": "^1.28.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "zod": "^3.23.8"
  }
}
